# Server Configuration
PORT=3001
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/damodarTraders?retryWrites=true&w=majority

# JWT Configuration (MUST BE 64+ CHARACTERS FOR SECURITY IN PRODUCTION!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
REFRESH_EXPIRES_IN=30d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Credentials
ADMIN_USERNAME=admin
# Generate bcrypt hash of admin password and set it here (REQUIRED for all environments - startup will fail if missing):
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash_here

# CORS Configuration
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
