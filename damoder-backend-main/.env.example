# Server Configuration
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Database - MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority

# Redis (REQUIRED for production - queues, caching, rate limiting)
# For Render: Use Upstash Redis (Free Tier)
# Format: rediss://default:password@host:port
REDIS_URL=rediss://default:your_redis_password@your_redis_host:6379

# Authentication - MUST BE 64+ CHARACTERS FOR SECURITY!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_char_jwt_secret_min_length_64_for_production_security
JWT_ACCESS_SECRET=your_64_char_access_secret_min_length_64_for_production_security
JWT_REFRESH_SECRET=your_64_char_refresh_secret_min_length_64_for_production_security
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security - Production Settings
COOKIE_SECRET=your_64_char_cookie_secret_min_length_64_for_production_security
SESSION_SECRET=your_64_char_session_secret_min_length_64_for_production_security
TRUST_PROXY=true  # Required for Render/Heroku behind reverse proxy
COOKIE_SECURE=true  # true for HTTPS production
COOKIE_SAME_SITE=lax
FORCE_SECURE_COOKIES=true

# Google OAuth (Required for production)
# Redirect URIs should include: https://your-backend.onrender.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/api/v1/auth/google/callback

# Google reCAPTCHA v3 (Required in production - startup will fail if missing or placeholder)
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Email (Required for production - Gmail with App Password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SERVICE=gmail

# Rate Limiting (Conservative for Render Free Tier)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=50

# Logging (warn/error for production performance)
LOG_LEVEL=warn
LOG_FORMAT=tiny

# Performance Tuning for Render Free Tier
CACHE_TTL=600
WARMUP_DELAY=3000
SLOW_REQUEST_THRESHOLD=2000

# Render-Specific Optimizations
RENDER=true
INSTANCE_TYPE=free
MAX_CONNECTIONS=50
LAZY_LOAD_MODELS=true
DISABLE_COLD_START_LOGGING=false

# Application URLs (Update after deployment)
BACKEND_URL=https://your-app.onrender.com
BACKEND_URL=https://your-app.onrender.com
