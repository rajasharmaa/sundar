# Render ignore file - excludes files from deployment

# Dependencies (installed during build)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Git
.git/
.gitignore
.gitattributes

# IDE and Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Testing
coverage/
.nyc_output/

# Build artifacts
dist/
build/

# Uploads (keep directory but not files)
uploads/*
!uploads/.gitkeep

# Temporary files
tmp/
temp/
*.tmp

# Documentation (optional - exclude to save space)
README.md
CHANGELOG.md
RENDER_DEPLOYMENT_GUIDE.md

# Test files
test/
tests/
*.test.js
*.spec.js

# Development configs
.eslintrc
.prettierrc
nodemon.json
